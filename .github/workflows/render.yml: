name: render
run-name: render ${{ inputs.job_id }}

on:
  workflow_dispatch:
    inputs:
      job_id:
        description: Job id
        required: true
      payload:
        description: JSON payload
        required: true

jobs:
  render:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Install ffmpeg
        run: sudo apt-get update && sudo apt-get install -y ffmpeg
      - name: Render
        env:
          PAYLOAD: ${{ inputs.payload }}
        run: node render.mjs
      - uses: actions/upload-artifact@v4
        with:
          name: video-${{ inputs.job_id }}
          path: work/out/*
          if-no-files-found: error
